// Vättigt on Cloudflare: one Worker serves the game and runs the rooms.
// Deployed from main by .github/workflows/deploy.yml (needs CLOUDFLARE_API_TOKEN).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vattigt",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  // The repository root is the site; .assetsignore keeps everything else out.
  "assets": { "directory": "." },
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  // Free plan: SQLite-backed Durable Objects only.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": { "ROOM_JURISDICTION": "eu" },
  // network-kit's admin page (F-043): on/off, timers, emergency stop, budget, game links and notices.
  // The game asks it over this binding; if it cannot be reached, the game stays open.
  "services": [{ "binding": "NETWORK_KIT_ADMIN", "service": "network-kit-admin", "entrypoint": "GameApi" }],
  "observability": { "enabled": false }
}
